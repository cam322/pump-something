<svg width="400" height="400" viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg">
  <!-- Background with gradient -->
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1a1a2e;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#16213e;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="border" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#22c55e;stop-opacity:0.5" />
      <stop offset="100%" style="stop-color:#22c55e;stop-opacity:0.8" />
    </linearGradient>
    <filter id="glow">
      <feGaussianBlur stdDeviation="3" result="coloredBlur"/>
      <feMerge> 
        <feMergeNode in="coloredBlur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>
  
  <!-- Background -->
  <rect width="400" height="400" fill="url(#bg)" stroke="url(#border)" stroke-width="4" rx="20"/>
  
  <!-- Placeholder icon -->
  <g filter="url(#glow)" transform="translate(200,200)">
    <circle cx="0" cy="0" r="60" fill="#22c55e" opacity="0.3"/>
    <circle cx="0" cy="0" r="50" fill="#22c55e"/>
    <text x="0" y="12" font-size="48" font-weight="bold" text-anchor="middle" fill="#000">🖼️</text>
  </g>
  
  <!-- Border dots -->
  <circle cx="30" cy="30" r="6" fill="#22c55e" opacity="0.6"/>
  <circle cx="370" cy="30" r="6" fill="#22c55e" opacity="0.6"/>
  <circle cx="30" cy="370" r="6" fill="#22c55e" opacity="0.6"/>
  <circle cx="370" cy="370" r="6" fill="#22c55e" opacity="0.6"/>
</svg>